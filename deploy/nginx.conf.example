# Include deploy/mobile-routing.conf once at nginx http scope.
# Use the following within an existing HTTPS server block with your real certificate.
add_header Vary "User-Agent" always;
if ($period_observer_mobile_target) {
    return 302 $period_observer_mobile_target$is_args$args;
}
location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 180s;
}
